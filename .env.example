# repoguard does NOT read .env files (no python-dotenv) — set these in the
# same terminal you run `repoguard fix` / `repoguard serve` from:
#
#   PowerShell:  $env:WATSONX_APIKEY="..."; $env:WATSONX_PROJECT_ID="..."
#   bash/zsh:    export WATSONX_APIKEY=... WATSONX_PROJECT_ID=...
#
# Optional, only if your watsonx.ai project isn't in Dallas (us-south):
#   WATSONX_URL=https://<region>.ml.cloud.ibm.com
#
# How to get them: docs/WATSONX_SETUP.md
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
