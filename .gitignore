# Byte-compiled / optimised
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json

# pytest cache
.pytest_cache/

# Mutation testing artefacts
.mutmut-cache
mutmut-results/

# Environment variables
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Demo repo generated artefacts
demo-repo/.coverage
demo-repo/htmlcov/
demo-repo/.pytest_cache/

# RepoGuard engine outputs (written to target repo; never commit)
repoguard-out/
**/repoguard-out/

# repoguard fix's auto-written run reports (target repo; never commit)
watson-evidence/
**/watson-evidence/

# Terraform local state — can contain sensitive attribute values; state
# for this project is local on purpose (see infra/terraform/README.md)
infra/terraform/.terraform/
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/*.tfplan
